# Copy this file to apps/api/.env and fill in the values. Never commit .env or paste keys in chat.
# Leave both empty to run with in-memory demo data instead of Postgres.

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=
# Supabase Dashboard > Project Settings > API Keys > service_role (secret). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787

# AI niche suggestions (optional). Create a key at console.anthropic.com > API keys. Leave empty to use the built-in catalog.
ANTHROPIC_API_KEY=
# Limits per API process: seconds between calls, calls per day, and an estimated daily spend cap in USD.
NICHE_MIN_INTERVAL_SEC=20
NICHE_MAX_CALLS_PER_DAY=20
NICHE_DAILY_BUDGET_USD=2
# Model used for suggestions (default claude-opus-5-5).
NICHE_MODEL=
