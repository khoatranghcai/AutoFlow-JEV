# Copy this file to apps/api/.env and fill in the values. Never commit .env or paste keys in chat.
# Leave both empty to run with in-memory demo data instead of Postgres.

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=
# Supabase Dashboard > Project Settings > API Keys > service_role (secret). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787
